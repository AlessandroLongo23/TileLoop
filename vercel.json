{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --workspace web",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm install",
  "rewrites": [{ "source": "/((?!assets/|tilesets/|sound/).*)", "destination": "/index.html" }]
}
